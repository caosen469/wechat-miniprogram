<view class="onboarding">
  <view class="hero">
    <view class="hero-title">家庭生活记录</view>
    <view class="hero-sub">把一起去过的地方、吃过的店，攒成共同的回忆</view>
  </view>

  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'join' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="join">
      邀请码入圈
    </view>
    <view class="mode-tab {{mode === 'create' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="create">
      创建家庭圈
    </view>
  </view>

  <view class="form">
    <view wx:if="{{mode === 'join'}}" class="field">
      <view class="field-label">邀请码</view>
      <input
        class="invite-input"
        placeholder="输入圈主给你的 6 位邀请码"
        maxlength="6"
        value="{{inviteCode}}"
        bindinput="onInviteCodeInput"
      />
    </view>

    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-placeholder">👤</view>
      <view class="avatar-hint">点击选择头像</view>
    </button>

    <view class="field">
      <view class="field-label">昵称</view>
      <input
        class="nickname-input"
        type="nickname"
        placeholder="点击填写昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>
  </view>

  <button
    wx:if="{{mode === 'create'}}"
    class="create-btn"
    type="primary"
    bindtap="onCreateCircle"
    disabled="{{submitting}}"
  >
    创建家庭圈
  </button>
  <button
    wx:else
    class="create-btn"
    type="primary"
    bindtap="onJoinCircle"
    disabled="{{submitting}}"
  >
    加入家庭圈
  </button>
  <view wx:if="{{mode === 'create'}}" class="join-hint">还没有圈？先创建；家人随后凭邀请码加入</view>
</view>
