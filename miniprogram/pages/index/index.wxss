.page {
  padding: 24rpx 32rpx 160rpx; /* 底部给 FAB 让位 */
  min-height: 100vh;
  box-sizing: border-box;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  margin: 120rpx 0 16rpx;
  text-align: center;
}

.subtitle {
  color: #999999;
  margin-bottom: 48rpx;
  text-align: center;
}

.test-btn {
  width: 100%;
}

/* 空状态 = 最小引导（spec 6.2） */
.empty {
  padding-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  color: #999999;
  font-size: 30rpx;
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 320rpx;
}

/* 足迹列表：地点为一等公民（spec 6.2，T19） */
.places {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.place-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 封面拼图（CSS grid，不必上 canvas） */
.mosaic {
  width: 100%;
  display: grid;
  gap: 4rpx;
}

.mosaic-one {
  grid-template-columns: 1fr;
}

.mosaic-one .mosaic-cell {
  height: 320rpx;
}

.mosaic-2 {
  grid-template-columns: 1fr 1fr;
}

.mosaic-2 .mosaic-cell {
  height: 240rpx;
}

.mosaic-3 {
  grid-template-columns: 1.6fr 1fr;
  grid-auto-rows: 132rpx;
}

.mosaic-3 .mosaic-main {
  grid-row: span 2;
}

/* 4 图：左大图跨 3 行 + 右列 3 小图，总高与 3 图拼图一致 */
.mosaic-4 {
  grid-template-columns: 1.6fr 1fr;
  grid-auto-rows: 88rpx;
}

.mosaic-4 .mosaic-main {
  grid-row: span 3;
}

.mosaic-cell {
  width: 100%;
  height: 100%;
}

.mosaic-empty {
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f0e8;
  font-size: 56rpx;
}

/* 卡片信息区 */
.pc-body {
  padding: 20rpx 24rpx 24rpx;
}

.pc-l1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pc-name {
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-chip {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8c6239;
  background-color: rgba(140, 98, 57, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.pc-l2 {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.stars {
  color: #e6a23c;
  letter-spacing: 2rpx;
}

.avg {
  color: #666666;
  font-weight: 600;
}

/* 情绪档位徽章（spec 3 三档配色） */
.grade-badge {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.badge-good {
  color: #1e8e5a;
  background-color: rgba(30, 142, 90, 0.12);
}

.badge-mid {
  color: #b97f14;
  background-color: rgba(185, 127, 20, 0.12);
}

.badge-bad {
  color: #cf4436;
  background-color: rgba(207, 68, 54, 0.12);
}

.tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 48rpx 0;
}

.feed-error {
  text-align: center;
  color: #c45656;
  font-size: 26rpx;
  padding: 32rpx 0;
}

/* 右下角常驻打卡按钮（spec 6.2） */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background-color: #8c6239;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(140, 98, 57, 0.4);
}
