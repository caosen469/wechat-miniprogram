<view class="page">
  <view wx:if="{{checking}}" class="title">正在进入…</view>

  <block wx:elif="{{checkFailed}}">
    <view class="title">身份检查失败</view>
    <view class="subtitle">{{checkError}}</view>
    <button class="test-btn" type="primary" bindtap="checkMembership">重试</button>
  </block>

  <block wx:else>
    <!-- 空状态 = 最小引导（spec 6.2）：一句话 + 打卡入口，不做示例内容 -->
    <view wx:if="{{!loadingFeed && records.length === 0 && !feedError}}" class="empty">
      <view class="empty-title">这里还空着，去吃点什么吧</view>
      <button class="empty-btn" type="primary" bindtap="onTapPublish">去打卡</button>
    </view>

    <!-- 简版记录流水：时间倒序，封面首图 + 地点 + 星级 + 吐槽 + 作者（T16） -->
    <view wx:else class="feed">
      <view
        class="card"
        wx:for="{{records}}"
        wx:key="_id"
        bindtap="onOpenRecord"
        data-id="{{item._id}}"
      >
        <image
          wx:if="{{item.coverFileID}}"
          class="cover"
          src="{{item.coverFileID}}"
          mode="aspectFill"
        />
        <view wx:else class="cover cover-empty">📷</view>
        <view class="info">
          <view class="place-row">
            <text class="place">{{item.place.name}}</text>
            <text class="grade">{{item.grade}}</text>
          </view>
          <view class="stars">{{item.stars}}</view>
          <view class="text" wx:if="{{item.text}}">{{item.text}}</view>
          <view class="meta">
            <image
              wx:if="{{item.author.avatarUrl}}"
              class="avatar"
              src="{{item.author.avatarUrl}}"
              mode="aspectFill"
            />
            <text>{{item.author.nickname}} · {{item.timeText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{loadingFeed && records.length === 0}}" class="tip">加载中…</view>
    <view wx:if="{{feedError}}" class="feed-error" bindtap="loadFeed">加载失败：{{feedError}}（点击重试）</view>

    <!-- 右下角常驻打卡按钮（spec 6.2） -->
    <view class="fab" bindtap="onTapPublish">＋</view>
  </block>
</view>
