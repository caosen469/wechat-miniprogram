<view class="container">
  <view wx:if="{{checking}}" class="title">正在进入…</view>

  <block wx:elif="{{checkFailed}}">
    <view class="title">身份检查失败</view>
    <view class="subtitle">{{checkError}}</view>
    <button class="test-btn" type="primary" bindtap="checkMembership">重试</button>
  </block>

  <block wx:else>
    <view class="title">Hello World 🏠</view>
    <view class="subtitle" wx:if="{{me}}">欢迎，{{me.nickname}}</view>

    <button class="test-btn" type="primary" bindtap="onTestCloud" disabled="{{testing}}">
      测试云函数连通
    </button>
    <view class="cloud-result" wx:if="{{cloudResult}}">{{cloudResult}}</view>

    <!-- 右下角常驻打卡按钮（spec 6.2）；列表形态 T16 落地 -->
    <view class="fab" bindtap="onTapPublish">＋</view>
  </block>
</view>
