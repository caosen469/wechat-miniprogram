<view class="page">
  <view wx:if="{{checking}}" class="title">正在进入…</view>

  <block wx:elif="{{checkFailed}}">
    <view class="title">身份检查失败</view>
    <view class="subtitle">{{checkError}}</view>
    <button class="test-btn" type="primary" bindtap="checkMembership">重试</button>
  </block>

  <block wx:else>
    <!-- 弱网队列状态条（spec 7.2）：有未同步记录时显示，补传成功即消失；
         点击弹说明，失败任务可放弃 -->
    <view wx:if="{{pendingCount > 0}}" class="pending-bar" bindtap="onTapPending">
      <text class="pending-icon">⏳</text>
      <text class="pending-text">{{pendingCount}} 条待同步</text>
    </view>

    <!-- 顶部段控「列表 | 地图」（spec 6.2）：同一份地点数据，两种视图 -->
    <view class="seg">
      <view class="seg-item {{viewMode === 'list' ? 'seg-on' : ''}}" data-mode="list" bindtap="onSwitchView">列表</view>
      <view class="seg-item {{viewMode === 'map' ? 'seg-on' : ''}}" data-mode="map" bindtap="onSwitchView">地图</view>
    </view>

    <!-- 新回忆红点条（spec 6.2/8.2）：unreadCount > 0 显示「N 条新回忆」；
         点击展开最新未读记录并 markRead 更新水位，红点消失（记录保留展示） -->
    <view wx:if="{{unreadCount > 0 || unreadOpen}}" class="unread">
      <view class="unread-bar" bindtap="onTapUnread">
        <view class="unread-dot {{unreadCount > 0 ? '' : 'unread-dot-off'}}"></view>
        <text class="unread-text">{{unreadCount > 0 ? unreadCount + ' 条新回忆' : '已读'}}</text>
        <text class="unread-arrow {{unreadOpen ? 'unread-arrow-open' : ''}}">▾</text>
      </view>
      <block wx:if="{{unreadOpen}}">
        <view wx:if="{{unreadLoading}}" class="unread-tip">加载中…</view>
        <view wx:elif="{{unreadError}}" class="unread-tip unread-error" bindtap="openUnread">加载失败，点击重试</view>
        <view wx:elif="{{unreadRecords.length === 0}}" class="unread-tip">没有新的回忆</view>
        <view wx:else class="unread-list">
          <view
            class="unread-item"
            wx:for="{{unreadRecords}}"
            wx:key="_id"
            bindtap="onOpenUnreadRecord"
            data-id="{{item._id}}"
          >
            <image wx:if="{{item.thumb}}" class="unread-thumb" src="{{item.thumb}}" mode="aspectFill" />
            <view wx:else class="unread-thumb unread-thumb-empty">📷</view>
            <view class="unread-body">
              <view class="unread-line">{{item.text || '（无文字）'}}</view>
              <view class="unread-meta">{{item.authorName}} · {{item.timeText}}</view>
            </view>
          </view>
          <view wx:if="{{unreadMore > 0}}" class="unread-tip">更早的还有 {{unreadMore}} 条未读</view>
        </view>
      </block>
    </view>

    <!-- 空状态 = 最小引导（spec 6.2）：一句话 + 打卡入口，不做示例内容（T6 决议）。
         列表/地图两种视图共用——没有地点时地图就是画布，都引导去打卡 -->
    <view wx:if="{{!loadingPlaces && places.length === 0 && !placesError}}" class="empty">
      <view class="empty-title">这里还空着，去吃点什么吧</view>
      <button class="empty-btn" type="primary" bindtap="onTapPublish">去打卡</button>
    </view>

    <!-- 地图视图（spec 6.2）：一店一 marker，customCallout 显示名称/均分/次数。
         marker id 为数字（placeId → 下标映射）；callout 用 cover-view slot 渲染，
         原生层置顶可点；include-points 让全部 marker 自适应视野 -->
    <map
      wx:if="{{viewMode === 'map' && markers.length > 0}}"
      class="map-view"
      longitude="{{mapCenter.longitude}}"
      latitude="{{mapCenter.latitude}}"
      scale="{{12}}"
      markers="{{markers}}"
      include-points="{{mapPoints}}"
    >
      <cover-view
        wx:for="{{markers}}"
        wx:key="id"
        slot="callout"
        marker-id="{{item.id}}"
        class="callout"
        data-marker-id="{{item.id}}"
        bindtap="onCalloutTap"
      >
        <cover-view class="callout-name">{{item.name}}</cover-view>
        <cover-view class="callout-meta">
          <cover-view class="callout-stars">{{item.stars}}</cover-view>
          <cover-view class="callout-avg">{{item.avgText}}</cover-view>
          <cover-view class="callout-visits">去过 {{item.visitCount}} 次</cover-view>
        </cover-view>
      </cover-view>
    </map>

    <!-- 有地点但都缺坐标（理论上不会：打卡必选点）：地图无可展示，给一句提示 -->
    <view wx:elif="{{viewMode === 'map' && places.length > 0}}" class="tip">地点暂无坐标，地图暂无可展示</view>

    <!-- 足迹列表：地点为一等公民（spec 6.2，T19） -->
    <view wx:if="{{viewMode === 'list' && !loadingPlaces && places.length > 0 && !placesError}}" class="places">
      <view
        class="place-card"
        wx:for="{{places}}"
        wx:key="_id"
        bindtap="onOpenPlace"
        data-id="{{item._id}}"
        data-name="{{item.name}}"
      >
        <!-- 封面拼图：1 图单图，2 图并排，3 图 1 大 2 小，4 图 1 大 3 小（CSS grid，不必上 canvas） -->
        <view wx:if="{{item.covers.length > 0}}" class="mosaic mosaic-{{item.covers.length === 1 ? 'one' : item.covers.length}}">
          <image
            wx:for="{{item.covers}}"
            wx:for-item="cover"
            wx:for-index="ci"
            wx:key="*this"
            class="mosaic-cell {{ci === 0 && item.covers.length >= 3 ? 'mosaic-main' : ''}}"
            src="{{cover}}"
            mode="aspectFill"
          />
        </view>
        <view wx:else class="mosaic-empty">📷</view>

        <view class="pc-body">
          <view class="pc-l1">
            <text class="pc-name">{{item.name}}</text>
            <text class="type-chip">{{item.typeLabel}}</text>
          </view>
          <view class="pc-l2">
            <text class="stars">{{item.stars}}</text>
            <text class="avg">{{item.avgText}}</text>
            <text class="visits">去过 {{item.visitCount}} 次</text>
            <text class="grade-badge badge-{{item.gradeKey}}">{{item.grade}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{loadingPlaces && places.length === 0}}" class="tip">加载中…</view>
    <view wx:if="{{placesError}}" class="feed-error" bindtap="loadPlaces">加载失败：{{placesError}}（点击重试）</view>

    <!-- 右下角常驻打卡按钮（spec 6.2）：cover-view 保证在地图原生组件之上仍可点 -->
    <cover-view class="fab" bindtap="onTapPublish">＋</cover-view>
  </block>
</view>
