<view class="page">
  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <block wx:elif="{{loadError}}">
    <view class="tip">{{loadError}}</view>
    <button class="retry-btn" type="primary" bindtap="onRetry">重试</button>
  </block>

  <block wx:else>
    <!-- 大图横滑翻页为主体（spec 6.4：图与视频混排翻页） -->
    <view class="media-wrap">
      <swiper class="media-swiper" indicator-dots circular>
        <swiper-item wx:for="{{media}}" wx:key="fileID">
          <video
            wx:if="{{item.isVideo && item.src}}"
            class="media"
            src="{{item.src}}"
            object-fit="contain"
            controls
          />
          <!-- 视频临时链接获取失败：给占位而非空裂图帧，可点击重试 -->
          <view wx:elif="{{item.isVideo}}" class="media-fallback" bindtap="onRetry">
            视频加载失败，点击重试
          </view>
          <image
            wx:else
            class="media"
            src="{{item.src}}"
            mode="aspectFill"
            data-src="{{item.src}}"
            bindtap="onPreviewImage"
          />
        </swiper-item>
      </swiper>
      <!-- 右上角「···」：编辑 / 删除（spec 6.4，避开微信胶囊按钮放其下方） -->
      <view class="more-btn" bindtap="onTapMore">···</view>
    </view>

    <view class="body">
      <!-- 固定地点上下文（spec 6.4） -->
      <view class="place-row" wx:if="{{place}}">
        <view class="place-name">{{place.name}}</view>
        <view class="place-sub">
          <text class="type-label">{{place.typeLabel}}</text>
          <text wx:if="{{visitNo > 0}}" class="visit-no">第 {{visitNo}} 次到访</text>
        </view>
      </view>

      <view class="stars-row">
        <text class="stars">{{record.stars}}</text>
        <text class="grade">{{record.grade}}</text>
        <!-- 「仅我俩」标识（spec 6.4：圈内可见者才看得到这条记录，自然也看得到标识） -->
        <text wx:if="{{record.visibility === 'pair'}}" class="pair-badge">💞 仅我俩</text>
      </view>

      <view class="text" wx:if="{{record.text}}">{{record.text}}</view>

      <!-- 语音条（spec 6.4：播放三角 + 波形 + 时长，点击播放/停止） -->
      <view wx:if="{{audio}}" class="audio-bar" bindtap="onAudioToggle">
        <view class="audio-play">{{audioPlaying ? '⏸' : '▶'}}</view>
        <view class="audio-wave">
          <view
            class="wave-bar {{audioPlaying ? 'on' : ''}}"
            wx:for="{{[12, 22, 16, 28, 20, 30, 14, 26, 18]}}"
            wx:key="*this"
            style="height: {{item}}rpx"
          />
        </view>
        <view class="audio-dur">{{audio.duration}}s</view>
      </view>

      <view class="meta">
        <image
          wx:if="{{author.avatarUrl}}"
          class="avatar"
          src="{{author.avatarUrl}}"
          mode="aspectFill"
        />
        <text>{{author.nickname}} · {{record.timeText}}</text>
      </view>

      <!-- 参与者（spec 4.5：同行的人，服务端 join 昵称头像） -->
      <view class="participants" wx:if="{{participants.length > 0}}">
        <text class="participants-label">同行</text>
        <view class="participant" wx:for="{{participants}}" wx:key="openid">
          <image class="avatar avatar-sm" src="{{item.avatarUrl}}" mode="aspectFill" />
          <text class="participant-name">{{item.nickname}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
