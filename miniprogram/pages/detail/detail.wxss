.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 96rpx 0;
}

.retry-btn {
  width: 320rpx;
  margin: 0 auto;
}

.media-swiper {
  width: 100%;
  height: 560rpx;
  background-color: #000000;
}

/* 右上角「···」（T20）：定位在微信胶囊下方，避开系统按钮 */
.media-wrap {
  position: relative;
}

.more-btn {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.media {
  width: 100%;
  height: 100%;
}

.media-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 26rpx;
  background-color: #1a1a1a;
}

.body {
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.place-name {
  font-size: 40rpx;
  font-weight: 600;
}

.place-sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.type-label {
  font-size: 24rpx;
  color: #8c6239;
  background-color: rgba(140, 98, 57, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.visit-no {
  font-size: 24rpx;
  color: #999999;
}

.stars-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stars {
  color: #e6a23c;
  font-size: 34rpx;
  letter-spacing: 4rpx;
}

.grade {
  font-size: 26rpx;
  color: #8c6239;
}

/* 「仅我俩」标识（T20，spec 6.4） */
.pair-badge {
  font-size: 22rpx;
  color: #c0507a;
  background-color: rgba(192, 80, 122, 0.1);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* ---- 语音条（T20，spec 6.4：播放三角 + 波形 + 时长） ---- */
.audio-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: #f7f3ec;
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
}

.audio-play {
  font-size: 28rpx;
  color: #8c6239;
  width: 36rpx;
  text-align: center;
}

.audio-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  overflow: hidden;
}

.wave-bar {
  width: 6rpx;
  border-radius: 3rpx;
  background-color: #d8c9b8;
}

.wave-bar.on {
  background-color: #8c6239;
}

.audio-dur {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}

.text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333333;
}

.meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #999999;
  font-size: 26rpx;
}

.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
}

/* ---- 参与者（T18：同行的人） ---- */
.participants {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.participants-label {
  font-size: 24rpx;
  color: #999999;
}

.participant {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.participant-name {
  font-size: 24rpx;
  color: #666666;
}
