.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 96rpx 0;
}

.retry-btn {
  width: 320rpx;
  margin: 0 auto;
}

.media-swiper {
  width: 100%;
  height: 560rpx;
  background-color: #000000;
}

.media {
  width: 100%;
  height: 100%;
}

.media-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 26rpx;
  background-color: #1a1a1a;
}

.body {
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.place-name {
  font-size: 40rpx;
  font-weight: 600;
}

.place-sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.type-label {
  font-size: 24rpx;
  color: #8c6239;
  background-color: rgba(140, 98, 57, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.visit-no {
  font-size: 24rpx;
  color: #999999;
}

.stars-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stars {
  color: #e6a23c;
  font-size: 34rpx;
  letter-spacing: 4rpx;
}

.grade {
  font-size: 26rpx;
  color: #8c6239;
}

.text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333333;
}

.meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #999999;
  font-size: 26rpx;
}

.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
}

/* ---- 参与者（T18：同行的人） ---- */
.participants {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.participants-label {
  font-size: 24rpx;
  color: #999999;
}

.participant {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.participant-name {
  font-size: 24rpx;
  color: #666666;
}

/* ---- 删除 ---- */
.danger-zone {
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f4f4f2;
}

.delete-btn {
  text-align: center;
  color: #e64340;
  font-size: 28rpx;
  padding: 16rpx 0;
}
