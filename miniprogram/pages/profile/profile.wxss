.profile {
  padding: 32rpx 32rpx 64rpx;
}

.placeholder {
  text-align: center;
  color: #999999;
  padding: 120rpx 0;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 资料行 / 成员行通用 */
.me-row,
.member-row {
  display: flex;
  align-items: center;
}

.member-row {
  padding: 16rpx 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  flex-shrink: 0;
}

.avatar-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
}

.me-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.me-nickname {
  font-size: 30rpx;
}

.me-nickname.inactive {
  color: #bbbbbb;
}

.me-role {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* 文字按钮 */
.link-btn {
  font-size: 26rpx;
  color: #8c6239;
  padding: 8rpx 16rpx;
}

.link-btn.danger {
  color: #e64340;
}

/* 编辑资料表单 */
.edit-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: inherit;
}

.avatar-btn::after {
  border: none;
}

.avatar-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.nickname-input {
  width: 100%;
  background-color: #faf7f2;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.edit-actions,
.invite-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
  width: 100%;
}

.edit-actions .btn-sm,
.invite-actions .btn-sm {
  flex: 1;
}

.btn-sm {
  font-size: 28rpx;
  margin: 0;
}

/* 邀请码展示 */
.invite-code {
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  color: #8c6239;
  padding: 24rpx 0 8rpx;
}

/* 退出家庭圈 */
.leave-btn {
  text-align: center;
  color: #e64340;
  font-size: 30rpx;
  padding: 8rpx 0;
}

.owner-note {
  text-align: center;
  color: #bbbbbb;
  font-size: 26rpx;
  padding: 8rpx 0;
}
