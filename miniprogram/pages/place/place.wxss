.page {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 统计条（spec 6.3） */
.stat-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 24rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.tier-good {
  color: #1e8e5a;
}

.tier-mid {
  color: #b97f14;
}

.tier-bad {
  color: #cf4436;
}

/* 记录缩略卡列表 */
.records {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 24rpx;
}

.cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f0e8;
  font-size: 56rpx;
}

.info {
  flex: 1;
  min-width: 0; /* 允许文字列内截断 */
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stars-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stars {
  color: #e6a23c;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.grade {
  font-size: 24rpx;
  color: #8c6239;
}

.text {
  font-size: 28rpx;
  color: #444444;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #999999;
  font-size: 24rpx;
  margin-top: auto;
}

.avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.tip {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 48rpx 0;
}

.load-error {
  text-align: center;
  color: #c45656;
  font-size: 26rpx;
  padding: 32rpx 0;
}
