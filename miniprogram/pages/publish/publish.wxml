<!-- 发布页·变体 C「拍摄优先」（T15 + T18 + T20）：
     九宫格媒体打头 → 吐槽 → 地点内联 → 星级 → 语音条 → 折叠区 → 底栏发布；
     带 recordId 进入为编辑模式（预填后走 updateRecord，地点只读）。 -->
<view class="publish">
  <!-- 编辑模式加载中/失败：收起表单，防止预填覆盖用户输入、防止默认值保存 -->
  <view wx:if="{{editLoading}}" class="edit-loading">读取这条回忆…</view>
  <view wx:elif="{{editFailed}}" class="edit-loading">
    <view>内容加载失败</view>
    <button class="retry-btn" size="mini" type="primary" bindtap="onRetryEdit">重试</button>
  </view>

  <block wx:else>
  <!-- 1. 九宫格媒体 -->
  <view class="grid">
    <view wx:for="{{media}}" wx:key="path" class="tile">
      <block wx:if="{{item.type === 'image'}}">
        <image class="tile-img" src="{{item.path}}" mode="aspectFill" />
      </block>
      <block wx:else>
        <view class="tile-video">
          <view class="tile-play">▶</view>
          <view class="tile-dur">{{item.duration}}s</view>
        </view>
      </block>
      <view class="tile-del" catchtap="onRemoveMedia" data-index="{{index}}">✕</view>
    </view>
    <view wx:if="{{media.length < totalMax}}" class="tile tile-add" bindtap="onAddMedia">
      <view class="add-plus">＋</view>
      <view class="add-hint">图 ≤9 · 视频 ≤3 段各 ≤60s · 合计 ≤12</view>
    </view>
  </view>

  <!-- 2. 吐槽文字 -->
  <textarea
    class="tt"
    value="{{text}}"
    maxlength="{{textMax}}"
    placeholder="这次体验如何？吐槽一句…（可加 emoji）"
    bindinput="onTextInput"
  />
  <view class="count">{{text.length}}/{{textMax}}</view>

  <!-- 3. 地点内联轻选 -->
  <view class="row" bindtap="onPlaceTap">
    <view class="row-ic">📍</view>
    <view class="row-grow">
      <view wx:if="{{place}}" class="place-name">{{place.name}}</view>
      <view wx:else class="place-placeholder">选择地点…</view>
      <view wx:if="{{place}}" class="row-meta">{{place.typeLabel}}{{!editRecordId && !place.poiId ? ' · 不参与自动归并' : ''}}</view>
      <view wx:elif="{{editRecordId}}" class="row-meta">编辑时地点不可更改</view>
      <view wx:else class="row-meta">POI 搜索 / 当前位置 / 手动输入</view>
    </view>
    <view wx:if="{{place && !editRecordId}}" class="place-clear" catchtap="onClearPlace">✕</view>
    <view wx:elif="{{!place}}" class="chev">›</view>
  </view>

  <!-- 4. 星级内联（必填） -->
  <view class="row">
    <view class="row-ic">⭐</view>
    <view class="stars">
      <view
        wx:for="{{[1, 2, 3, 4, 5]}}"
        wx:key="*this"
        class="star {{rating >= item ? 'on' : ''}}"
        bindtap="onSetRating"
        data-n="{{item}}"
      >★</view>
    </view>
    <view class="row-grow" />
    <view wx:if="{{grade}}" class="grade-badge">{{grade}}</view>
  </view>

  <!-- 5. 语音条内联（T20，spec 6.5：≤60s 自动停，可试听/重录/删） -->
  <view class="row row-last">
    <view class="row-ic">🎙</view>
    <view wx:if="{{recording}}" class="row-grow rec-live" bindtap="onRecordStop">
      <text class="rec-dot">●</text> 录音中 {{recordSecs}}s / 60s（点击停止）
    </view>
    <block wx:elif="{{audio}}">
      <view class="audio-bar" bindtap="onAudioPreview">
        <view class="audio-play">{{audioPlaying ? '⏸' : '▶'}}</view>
        <view class="audio-wave">
          <view class="wave-bar {{audioPlaying ? 'on' : ''}}" wx:for="{{[12, 22, 16, 28, 20, 30, 14, 26, 18]}}" wx:key="*this" style="height: {{item}}rpx" />
        </view>
        <view class="audio-dur">{{audio.duration}}s</view>
      </view>
      <view class="audio-op" catchtap="onAudioRerecord">重录</view>
      <view class="audio-op audio-op-del" catchtap="onAudioDelete">删除</view>
    </block>
    <view wx:else class="row-grow audio-hint" bindtap="onRecordStart">
      说点什么？点此录一段（最长 60s，可不录）
    </view>
  </view>

  <!-- 5. 折叠区「＋更多」默认收起（spec 6.5） -->
  <view class="more-toggle" bindtap="onToggleMore">{{moreOpen ? '－ 收起' : '＋ 更多'}}</view>
  <view wx:if="{{moreOpen}}" class="more">
    <!-- 参与者多选（可跳过） -->
    <view class="more-row">
      <view class="more-label">同行的人</view>
      <view class="chips" wx:if="{{participantOptions.length > 0}}">
        <view
          wx:for="{{participantOptions}}"
          wx:key="openid"
          class="chip {{item.on ? 'on' : ''}}"
          bindtap="onToggleParticipant"
          data-openid="{{item.openid}}"
        >{{item.nickname}}</view>
      </view>
      <view wx:else class="more-hint">圈里还没有其他成员</view>
    </view>

    <!-- 可见范围：入口同底栏快捷入口，共用三选一弹层 -->
    <view class="more-row" bindtap="onOpenVisibility">
      <view class="more-label">可见范围</view>
      <view class="more-value">{{visibilityLabel}} ›</view>
    </view>

    <!-- 补记时间：默认现在，可改 -->
    <view class="more-row">
      <view class="more-label">到访时间</view>
      <view wx:if="{{!timeCustom}}" class="more-value" bindtap="onEnableCustomTime">现在（点此补记）</view>
      <view wx:else class="pickers">
        <picker mode="date" value="{{customDate}}" bindchange="onPickCustomDate">
          <view class="picker-val">{{customDate || '选日期'}}</view>
        </picker>
        <picker mode="time" value="{{customTime}}" bindchange="onPickCustomTime">
          <view class="picker-val">{{customTime || '00:00'}}</view>
        </picker>
        <view class="more-reset" bindtap="onResetTime">恢复现在</view>
      </view>
    </view>
  </view>

  <!-- 6. 底栏：发布 + 可见范围快捷入口（三选一弹层，spec 6.5） -->
  <view class="bottom-bar">
    <view class="vis-entry" bindtap="onOpenVisibility">
      <view class="vis-entry-label">{{visibilityIcon}} {{visibilityLabel}}</view>
      <view class="vis-entry-sub">可见范围</view>
    </view>
    <button class="publish-btn" type="primary" bindtap="onPublish" disabled="{{submitting || editLoading || editFailed}}">
      {{editRecordId ? '保存' : '发布'}}
    </button>
  </view>
  </block>
</view>

<!-- 选点 sheet：POI 选定后选类型 / 手动新地点 -->
<view wx:if="{{sheet}}" class="sheet-mask" bindtap="onCloseSheet">
  <view class="sheet" catchtap="onSheetTap">
    <block wx:if="{{sheet === 'type'}}">
      <view class="sheet-title">📍 {{pendingName}}</view>
      <view class="sheet-sub">新地点首次打卡——选个类型用于归档；已打卡过的地点会自动沿用原类型。</view>
      <view class="chips">
        <view
          wx:for="{{typeOptions}}"
          wx:key="value"
          class="chip {{pendingType === item.value ? 'on' : ''}}"
          bindtap="onPickPendingType"
          data-value="{{item.value}}"
        >{{item.label}}</view>
      </view>
      <button class="sheet-btn" type="primary" bindtap="onConfirmPendingPlace">就打这里</button>
    </block>

    <block wx:if="{{sheet === 'manual'}}">
      <view class="sheet-title">📍 手动新地点</view>
      <view class="sheet-sub">给地方起个名、选个类型；不与地图上的店自动归并。</view>
      <input
        class="sheet-input"
        placeholder="地点名称，如「家里楼下」"
        value="{{manualName}}"
        bindinput="onManualNameInput"
        maxlength="50"
      />
      <view class="chips">
        <view
          wx:for="{{typeOptions}}"
          wx:key="value"
          class="chip {{manualType === item.value ? 'on' : ''}}"
          bindtap="onPickManualType"
          data-value="{{item.value}}"
        >{{item.label}}</view>
      </view>
      <button class="sheet-btn" type="primary" bindtap="onConfirmManualPlace">就打这里</button>
    </block>

    <!-- 可见范围三选一弹层（spec 6.5：弹层形式防「仅我俩」手滑） -->
    <block wx:if="{{sheet === 'vis'}}">
      <view class="sheet-title">这条记录谁能看？</view>
      <view
        wx:for="{{visibilityOptions}}"
        wx:key="value"
        class="vis-option {{visibility === item.value ? 'on' : ''}} {{item.value === 'pair' && !pairReady ? 'disabled' : ''}}"
        bindtap="onPickVisibility"
        data-value="{{item.value}}"
      >
        <view class="vis-option-main">
          <view class="vis-option-label">{{item.icon}} {{item.label}}</view>
          <view class="vis-option-desc">
            {{item.value === 'pair' && !pairReady ? (pairDesignated ? '只面向圈主指定的二人组成员' : '圈主还没指定另一半，暂不可用') : item.desc}}
          </view>
        </view>
        <view wx:if="{{visibility === item.value}}" class="vis-check">✓</view>
      </view>
    </block>
  </view>
</view>

<!-- 发布成功后的提醒引导（T24，spec 8.1：引导一次，勾选「总是保持以上选择」） -->
<view wx:if="{{reminderGuide}}" class="sheet-mask" bindtap="onGuideSkip">
  <view class="sheet" catchtap="onSheetTap">
    <view class="sheet-title">🔔 开启新回忆提醒</view>
    <view class="sheet-sub">家人发布新回忆时，微信会第一时间提醒你。建议在弹窗里勾选「总是保持以上选择」，以后不用每次确认。</view>
    <view class="guide-actions">
      <button class="btn-plain" bindtap="onGuideSkip">暂不</button>
      <button class="guide-btn" type="primary" bindtap="onGuideEnable">开启提醒</button>
    </view>
  </view>
</view>
