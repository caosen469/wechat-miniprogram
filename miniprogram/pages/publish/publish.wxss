/* 发布页（T15）：沿用 onboarding 的暖色 token（bg #faf7f2 / 主色 #8c6239） */

.publish {
  padding: 32rpx 32rpx 200rpx; /* 底部留白避让固定底栏 */
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #faf7f2;
}

/* ---- 九宫格媒体 ---- */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.tile {
  position: relative;
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #eeeeee;
}

.tile-img {
  width: 100%;
  height: 100%;
}

.tile-video {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #999999;
}

.tile-play {
  font-size: 48rpx;
}

.tile-dur {
  font-size: 24rpx;
}

.tile-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tile-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed #d8d8d5;
  background-color: transparent;
  color: #bbbbbb;
}

.add-plus {
  font-size: 56rpx;
  line-height: 1;
}

.add-hint {
  font-size: 20rpx;
  text-align: center;
  line-height: 1.5;
  padding: 0 8rpx;
}

/* ---- 吐槽 ---- */
.tt {
  width: 100%;
  min-height: 160rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.7;
  box-sizing: border-box;
  margin-top: 32rpx;
}

.count {
  text-align: right;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 8rpx;
}

/* ---- 地点 / 星级行 ---- */
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #eae6df;
  margin-top: 8rpx;
}

.row-last {
  border-bottom: none;
}

.row-ic {
  font-size: 36rpx;
}

.row-grow {
  flex: 1;
}

.place-name {
  font-size: 30rpx;
  font-weight: 600;
}

.place-placeholder {
  font-size: 30rpx;
  color: #999999;
}

.row-meta {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.place-clear {
  color: #bbbbbb;
  font-size: 28rpx;
  padding: 8rpx;
}

.chev {
  color: #cccccc;
  font-size: 32rpx;
}

/* ---- 星级 ---- */
.stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 56rpx;
  line-height: 1;
  color: #d8d8d5;
}

.star.on {
  color: #b97f14;
}

.grade-badge {
  font-size: 24rpx;
  color: #8c6239;
  background-color: rgba(140, 98, 57, 0.1);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* ---- 语音条内联（T20） ---- */
.audio-hint {
  font-size: 30rpx;
  color: #999999;
}

.rec-live {
  font-size: 28rpx;
  color: #e64340;
}

.rec-dot {
  animation: rec-blink 1s infinite;
}

@keyframes rec-blink {
  50% { opacity: 0.2; }
}

.audio-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: #ffffff;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  flex: 1;
  min-width: 0;
}

.audio-play {
  font-size: 28rpx;
  color: #8c6239;
  width: 36rpx;
  text-align: center;
}

.audio-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  overflow: hidden;
}

.wave-bar {
  width: 6rpx;
  border-radius: 3rpx;
  background-color: #d8c9b8;
}

.wave-bar.on {
  background-color: #8c6239;
}

.audio-dur {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}

.audio-op {
  font-size: 26rpx;
  color: #8c6239;
  padding: 8rpx;
  flex-shrink: 0;
}

.audio-op-del {
  color: #bbbbbb;
}

.edit-loading {
  text-align: center;
  font-size: 26rpx;
  color: #999999;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

/* ---- 折叠区「＋更多」 ---- */
.more-toggle {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #8c6239;
  padding: 8rpx 0;
}

.more {
  background-color: #f9f9f7;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-top: 12rpx;
}

.more-row {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #efefec;
}

.more-row:last-child {
  border-bottom: none;
}

.more-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.more-hint {
  font-size: 26rpx;
  color: #bbbbbb;
}

.more-value {
  font-size: 28rpx;
  color: #333333;
}

.more-reset {
  font-size: 24rpx;
  color: #8c6239;
  padding: 8rpx 0 8rpx 16rpx;
}

.pickers {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-val {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
}

/* ---- 底栏：可见范围快捷入口 + 发布 ---- */
.bottom-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.vis-entry {
  flex-shrink: 0;
  text-align: center;
  padding: 8rpx 12rpx;
}

.vis-entry-label {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
}

.vis-entry-sub {
  font-size: 20rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* 三选一弹层选项 */
.vis-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border: 2rpx solid #efefec;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.vis-option.on {
  border-color: #8c6239;
  background-color: rgba(140, 98, 57, 0.06);
}

.vis-option.disabled {
  opacity: 0.45;
}

.vis-option-label {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
}

.vis-option-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.vis-check {
  font-size: 32rpx;
  color: #8c6239;
  font-weight: 700;
}

/* ---- 发布按钮 ---- */
.publish-btn {
  flex-grow: 1;
}

/* ---- 选点 sheet ---- */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 20;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.sheet-sub {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.sheet-input {
  background-color: #f4f4f2;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.chip {
  border: 2rpx solid #d8d8d5;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
}

.chip.on {
  border-color: #8c6239;
  color: #8c6239;
  background-color: rgba(140, 98, 57, 0.08);
  font-weight: 600;
}

.sheet-btn {
  width: 100%;
}
